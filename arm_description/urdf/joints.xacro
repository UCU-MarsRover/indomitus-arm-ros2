<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <joint name="world_to_base_joint" type="fixed">
    <parent link="world_link"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <joint name="joint_0" type="continuous">
    <parent link="base_link"/>
    <child link="link_0"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="joint_1" type="revolute">
    <parent link="link_0"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.174533" upper="3.839724" effort="20.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.55" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.785398" upper="4.450590" effort="20.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.40" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.396263" upper="4.537856" effort="20.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="3.141593" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>

  <joint name="joint_5" type="continuous">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

</robot>
